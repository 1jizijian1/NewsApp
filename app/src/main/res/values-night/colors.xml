<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      ★ 同一套【角色色】，深色主题版

      规律：浅色主题用"深色"当前景（压浅底），
            深色主题反过来用"浅色"当前景（压深底）。
      对比度就是这么保住的。
    -->

    <!-- 主色：换成亮蓝，不然深蓝压在黑底上看不见 -->
    <color name="md_theme_primary">#ADC6FF</color>
    <color name="md_theme_onPrimary">#002E69</color>
    <color name="md_theme_primaryContainer">#00458F</color>
    <color name="md_theme_onPrimaryContainer">#D8E2FF</color>

    <color name="md_theme_secondary">#BEC6DC</color>
    <color name="md_theme_onSecondary">#283041</color>
    <color name="md_theme_secondaryContainer">#3E4759</color>
    <color name="md_theme_onSecondaryContainer">#DAE2F9</color>

    <color name="md_theme_surface">#111318</color>
    <color name="md_theme_onSurface">#E2E2E9</color>
    <color name="md_theme_surfaceVariant">#44474F</color>
    <color name="md_theme_onSurfaceVariant">#C4C6D0</color>

    <color name="md_theme_outline">#8E9099</color>
    <color name="md_theme_outlineVariant">#44474F</color>

    <!-- ★ 星数：暗底上要亮金才看得清 -->
    <color name="star">#FFC857</color>

    <color name="rank_gold">#FFC857</color>
    <color name="rank_silver">#C7C7CC</color>
    <color name="rank_bronze">#D9A07A</color>
    <color name="rank_normal">#C4C6D0</color>

    <!-- ★ 深色主题下用更深的蓝 —— 冷启动时不会"闪一下亮" -->
    <color name="splash_bg">#0A1F44</color>
</resources>
